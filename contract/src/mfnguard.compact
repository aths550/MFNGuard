pragma language_version 0.23;

import CompactStandardLibrary;

export struct PriceClass {
    slots: Vector<5, Bytes<32>>;
    filled: Vector<5, Uint<8>>;
    supplier_hashes: Vector<5, Bytes<32>>;
    buyer_ref: Bytes<32>;
    buyer_filled: Uint<8>;
    buyer_hash: Bytes<32>;
    auditor_hash: Bytes<32>;
    comparability_hash: Bytes<32>;
}

export struct ComplianceResult {
    compliant: Uint<8>;
    discrepancy: Uint<64>;
    committed_count: Uint<8>;
}

export struct DisputeResult {
    violator_found: Uint<8>;
    violator_price: Uint<64>;
    violator_index: Uint<8>;
}

export ledger classes: Map<Bytes<32>, PriceClass>;
export ledger state: Map<Uint<8>, Bytes<32>>;

export circuit init_contract(owner_hash: Bytes<32>): [] {
    assert(!state.member(0), "Contract already initialized");
    state.insert(0, disclose(owner_hash));
}

export circuit initialize_class(
    owner_secret: Bytes<32>, 
    class_id: Bytes<32>, 
    buyer_hash: Bytes<32>,
    auditor_hash: Bytes<32>,
    supplier_hashes: Vector<5, Bytes<32>>,
    comparability_hash: Bytes<32>
): [] {
    assert(state.member(0), "Contract not initialized");
    const TAG_OWNER = 4 as Field as Bytes<32>;
    const expected_owner = persistentHash<Vector<2, Bytes<32>>>([TAG_OWNER, owner_secret]);
    assert(expected_owner == state.lookup(0), "Unauthorized: Not the contract owner");
    
    const is_member = classes.member(disclose(class_id));
    assert(!is_member, "Class already exists");
    
    const empty_bytes = 0 as Field as Bytes<32>;
    assert(buyer_hash != empty_bytes, "Buyer hash cannot be zero");
    assert(auditor_hash != empty_bytes, "Auditor hash cannot be zero");
    assert(supplier_hashes[0] != empty_bytes, "Supplier hash 0 cannot be zero");
    assert(supplier_hashes[1] != empty_bytes, "Supplier hash 1 cannot be zero");
    assert(supplier_hashes[2] != empty_bytes, "Supplier hash 2 cannot be zero");
    assert(supplier_hashes[3] != empty_bytes, "Supplier hash 3 cannot be zero");
    assert(supplier_hashes[4] != empty_bytes, "Supplier hash 4 cannot be zero");
    
    assert(supplier_hashes[0] != supplier_hashes[1], "Supplier hashes must be distinct");
    assert(supplier_hashes[0] != supplier_hashes[2], "Supplier hashes must be distinct");
    assert(supplier_hashes[0] != supplier_hashes[3], "Supplier hashes must be distinct");
    assert(supplier_hashes[0] != supplier_hashes[4], "Supplier hashes must be distinct");
    assert(supplier_hashes[1] != supplier_hashes[2], "Supplier hashes must be distinct");
    assert(supplier_hashes[1] != supplier_hashes[3], "Supplier hashes must be distinct");
    assert(supplier_hashes[1] != supplier_hashes[4], "Supplier hashes must be distinct");
    assert(supplier_hashes[2] != supplier_hashes[3], "Supplier hashes must be distinct");
    assert(supplier_hashes[2] != supplier_hashes[4], "Supplier hashes must be distinct");
    assert(supplier_hashes[3] != supplier_hashes[4], "Supplier hashes must be distinct");
    
    const empty_slots = [empty_bytes, empty_bytes, empty_bytes, empty_bytes, empty_bytes] as Vector<5, Bytes<32>>;
    const empty_filled = [0, 0, 0, 0, 0] as Vector<5, Uint<8>>;
    
    const initial_class = PriceClass {
        slots: empty_slots,
        filled: empty_filled,
        supplier_hashes: supplier_hashes,
        buyer_ref: empty_bytes,
        buyer_filled: 0,
        buyer_hash: buyer_hash,
        auditor_hash: auditor_hash,
        comparability_hash: comparability_hash
    };
    
    classes.insert(disclose(class_id), disclose(initial_class));
}

export circuit compute_auditor_hash(secret: Bytes<32>): Bytes<32> {
    const TAG_AUDITOR = 1 as Field as Bytes<32>;
    return persistentHash<Vector<2, Bytes<32>>>([TAG_AUDITOR, secret]);
}

export circuit compute_owner_hash(secret: Bytes<32>): Bytes<32> {
    const TAG_OWNER = 4 as Field as Bytes<32>;
    return persistentHash<Vector<2, Bytes<32>>>([TAG_OWNER, secret]);
}

export circuit compute_supplier_hash(secret: Bytes<32>): Bytes<32> {
    const TAG_SUPPLIER = 5 as Field as Bytes<32>;
    return persistentHash<Vector<2, Bytes<32>>>([TAG_SUPPLIER, secret]);
}

export circuit compute_buyer_hash(secret: Bytes<32>): Bytes<32> {
    const TAG_BUYER_SECRET = 7 as Field as Bytes<32>;
    return persistentHash<Vector<2, Bytes<32>>>([TAG_BUYER_SECRET, secret]);
}

export circuit compute_comparability_hash(
    product: Bytes<32>,
    volume: Bytes<32>,
    region: Bytes<32>,
    term: Bytes<32>,
    currency: Bytes<32>,
    date_window: Bytes<32>
): Bytes<32> {
    const TAG_COMPARABILITY = 6 as Field as Bytes<32>;
    return persistentHash<Vector<7, Bytes<32>>>([
        TAG_COMPARABILITY, product, volume, region, term, currency, date_window
    ]);
}

export circuit commit_price(
    class_id: Bytes<32>, 
    supplier_secret: Bytes<32>,
    slot_index: Uint<64>,
    price: Uint<64>, 
    salt: Bytes<32>
): [] {
    assert(price > 0, "Price must be strictly positive");
    assert(price < 100000000000, "Price exceeds sanity limit");
    assert(slot_index < 5, "Invalid slot index");
    
    const is_member = classes.member(disclose(class_id));
    assert(is_member, "Class does not exist");
    
    const current_class = classes.lookup(disclose(class_id));
    
    const TAG_SUPPLIER = 5 as Field as Bytes<32>;
    const expected_supplier = persistentHash<Vector<2, Bytes<32>>>([TAG_SUPPLIER, supplier_secret]);
    
    const auth_hash = slot_index == 0 ? current_class.supplier_hashes[0] :
                      slot_index == 1 ? current_class.supplier_hashes[1] :
                      slot_index == 2 ? current_class.supplier_hashes[2] :
                      slot_index == 3 ? current_class.supplier_hashes[3] :
                                        current_class.supplier_hashes[4];
    assert(expected_supplier == auth_hash, "Unauthorized supplier for this slot");
    
    const is_empty = slot_index == 0 ? current_class.filled[0] == 0 :
                     slot_index == 1 ? current_class.filled[1] == 0 :
                     slot_index == 2 ? current_class.filled[2] == 0 :
                     slot_index == 3 ? current_class.filled[3] == 0 :
                                       current_class.filled[4] == 0;
    assert(is_empty, "Slot already filled");
    
    const TAG_PRICE_COMMIT = 2 as Field as Bytes<32>;
    const commitment = persistentHash<Vector<5, Bytes<32>>>([TAG_PRICE_COMMIT, class_id, current_class.comparability_hash, price as Field as Bytes<32>, salt]);
    
    const next_slots = [
        slot_index == 0 ? commitment : current_class.slots[0],
        slot_index == 1 ? commitment : current_class.slots[1],
        slot_index == 2 ? commitment : current_class.slots[2],
        slot_index == 3 ? commitment : current_class.slots[3],
        slot_index == 4 ? commitment : current_class.slots[4]
    ] as Vector<5, Bytes<32>>;
    
    const next_filled = [
        slot_index == 0 ? 1 : current_class.filled[0],
        slot_index == 1 ? 1 : current_class.filled[1],
        slot_index == 2 ? 1 : current_class.filled[2],
        slot_index == 3 ? 1 : current_class.filled[3],
        slot_index == 4 ? 1 : current_class.filled[4]
    ] as Vector<5, Uint<8>>;
    
    const next_class = PriceClass {
        slots: next_slots,
        filled: next_filled,
        supplier_hashes: current_class.supplier_hashes,
        buyer_ref: current_class.buyer_ref,
        buyer_filled: current_class.buyer_filled,
        buyer_hash: current_class.buyer_hash,
        auditor_hash: current_class.auditor_hash,
        comparability_hash: current_class.comparability_hash
    };
    
    classes.insert(disclose(class_id), disclose(next_class));
}

export circuit set_buyer_reference(class_id: Bytes<32>, buyer_secret: Bytes<32>, price: Uint<64>, salt: Bytes<32>): [] {
    assert(price > 0, "Price must be strictly positive");
    assert(price < 100000000000, "Price exceeds sanity limit");
    
    const is_member = classes.member(disclose(class_id));
    assert(is_member, "Class does not exist");
    const current_class = classes.lookup(disclose(class_id));
    
    assert(current_class.buyer_filled == 0, "Buyer reference already set");
    
    const TAG_BUYER_SECRET = 7 as Field as Bytes<32>;
    const expected_buyer_hash = persistentHash<Vector<2, Bytes<32>>>([TAG_BUYER_SECRET, buyer_secret]);
    assert(expected_buyer_hash == current_class.buyer_hash, "Unauthorized buyer");
    
    const TAG_BUYER_COMMIT = 3 as Field as Bytes<32>;
    const commitment = persistentHash<Vector<5, Bytes<32>>>([TAG_BUYER_COMMIT, class_id, current_class.comparability_hash, price as Field as Bytes<32>, salt]);
    
    const next_class = PriceClass {
        slots: current_class.slots,
        filled: current_class.filled,
        supplier_hashes: current_class.supplier_hashes,
        buyer_ref: commitment,
        buyer_filled: 1,
        buyer_hash: current_class.buyer_hash,
        auditor_hash: current_class.auditor_hash,
        comparability_hash: current_class.comparability_hash
    };
    
    classes.insert(disclose(class_id), disclose(next_class));
}

export circuit compliance_check(
    class_id: Bytes<32>, 
    buyer_price: Uint<64>, 
    buyer_salt: Bytes<32>,
    supplier_prices: Vector<5, Uint<64>>,
    supplier_salts: Vector<5, Bytes<32>>,
    product: Bytes<32>,
    volume: Bytes<32>,
    region: Bytes<32>,
    term: Bytes<32>,
    currency: Bytes<32>,
    date_window: Bytes<32>
): ComplianceResult {
    const TAG_PRICE_COMMIT = 2 as Field as Bytes<32>;
    const TAG_BUYER_COMMIT = 3 as Field as Bytes<32>;
    const TAG_COMPARABILITY = 6 as Field as Bytes<32>;
    
    const class_state = classes.lookup(disclose(class_id));
    assert(class_state.buyer_filled == 1, "Buyer reference not set");
    
    const computed_comp = persistentHash<Vector<7, Bytes<32>>>([
        TAG_COMPARABILITY, product, volume, region, term, currency, date_window
    ]);
    assert(computed_comp == class_state.comparability_hash, "Comparability attributes do not match the class definition");
    
    const expected_buyer_commit = persistentHash<Vector<5, Bytes<32>>>([TAG_BUYER_COMMIT, class_id, class_state.comparability_hash, buyer_price as Field as Bytes<32>, buyer_salt]);
    assert(expected_buyer_commit == class_state.buyer_ref, "Buyer witness does not match commitment");
    
    const max_val = 18446744073709551615;
    
    const p0 = (class_state.filled[0] == 1) ? supplier_prices[0] : max_val;
    const expected_commit_0 = persistentHash<Vector<5, Bytes<32>>>([TAG_PRICE_COMMIT, class_id, class_state.comparability_hash, p0 as Field as Bytes<32>, supplier_salts[0]]);
    assert(class_state.filled[0] == 0 || expected_commit_0 == class_state.slots[0], "Supplier witness 0 does not match");

    const p1 = (class_state.filled[1] == 1) ? supplier_prices[1] : max_val;
    const expected_commit_1 = persistentHash<Vector<5, Bytes<32>>>([TAG_PRICE_COMMIT, class_id, class_state.comparability_hash, p1 as Field as Bytes<32>, supplier_salts[1]]);
    assert(class_state.filled[1] == 0 || expected_commit_1 == class_state.slots[1], "Supplier witness 1 does not match");

    const p2 = (class_state.filled[2] == 1) ? supplier_prices[2] : max_val;
    const expected_commit_2 = persistentHash<Vector<5, Bytes<32>>>([TAG_PRICE_COMMIT, class_id, class_state.comparability_hash, p2 as Field as Bytes<32>, supplier_salts[2]]);
    assert(class_state.filled[2] == 0 || expected_commit_2 == class_state.slots[2], "Supplier witness 2 does not match");

    const p3 = (class_state.filled[3] == 1) ? supplier_prices[3] : max_val;
    const expected_commit_3 = persistentHash<Vector<5, Bytes<32>>>([TAG_PRICE_COMMIT, class_id, class_state.comparability_hash, p3 as Field as Bytes<32>, supplier_salts[3]]);
    assert(class_state.filled[3] == 0 || expected_commit_3 == class_state.slots[3], "Supplier witness 3 does not match");

    const p4 = (class_state.filled[4] == 1) ? supplier_prices[4] : max_val;
    const expected_commit_4 = persistentHash<Vector<5, Bytes<32>>>([TAG_PRICE_COMMIT, class_id, class_state.comparability_hash, p4 as Field as Bytes<32>, supplier_salts[4]]);
    assert(class_state.filled[4] == 0 || expected_commit_4 == class_state.slots[4], "Supplier witness 4 does not match");

    const has_any = class_state.filled[0] == 1 || class_state.filled[1] == 1 || class_state.filled[2] == 1 || class_state.filled[3] == 1 || class_state.filled[4] == 1;
    assert(has_any, "No supplier prices committed");
    
    const min1 = (p0 < p1) ? p0 : p1;
    const min2 = (p2 < p3) ? p2 : p3;
    const min3 = (min1 < min2) ? min1 : min2;
    const min_supplier_price = (min3 < p4) ? min3 : p4;
    
    const count_raw = (class_state.filled[0]) + (class_state.filled[1]) + (class_state.filled[2]) + (class_state.filled[3]) + (class_state.filled[4]);
    const count = count_raw as Uint<8>;
    
    if (min_supplier_price < buyer_price) {
        return ComplianceResult { compliant: 0, discrepancy: buyer_price - min_supplier_price, committed_count: count };
    } else {
        return ComplianceResult { compliant: 1, discrepancy: 0, committed_count: count };
    }
}

export circuit reveal_violation(
    class_id: Bytes<32>,
    buyer_price: Uint<64>, 
    buyer_salt: Bytes<32>,
    supplier_prices: Vector<5, Uint<64>>,
    supplier_salts: Vector<5, Bytes<32>>,
    auditor_secret: Bytes<32>,
    product: Bytes<32>,
    volume: Bytes<32>,
    region: Bytes<32>,
    term: Bytes<32>,
    currency: Bytes<32>,
    date_window: Bytes<32>
): DisputeResult {
    const TAG_AUDITOR = 1 as Field as Bytes<32>;
    const expected_auditor_hash = persistentHash<Vector<2, Bytes<32>>>([TAG_AUDITOR, auditor_secret]);
    
    const class_state = classes.lookup(disclose(class_id));
    assert(expected_auditor_hash == class_state.auditor_hash, "Unauthorized auditor");
    
    const result = compliance_check(
        class_id, buyer_price, buyer_salt, supplier_prices, supplier_salts,
        product, volume, region, term, currency, date_window
    );
    assert(result.compliant == 0, "No violation to reveal");
    
    const max_val = 18446744073709551615;
    const p0 = (class_state.filled[0] == 1) ? supplier_prices[0] : max_val;
    const p1 = (class_state.filled[1] == 1) ? supplier_prices[1] : max_val;
    const p2 = (class_state.filled[2] == 1) ? supplier_prices[2] : max_val;
    const p3 = (class_state.filled[3] == 1) ? supplier_prices[3] : max_val;
    const p4 = (class_state.filled[4] == 1) ? supplier_prices[4] : max_val;
    
    const v0 = p0 < buyer_price;
    const v1 = p1 < buyer_price;
    const v2 = p2 < buyer_price;
    const v3 = p3 < buyer_price;
    const v4 = p4 < buyer_price;
    
    const found = 1;
    const v_price = v0 ? p0 : (v1 ? p1 : (v2 ? p2 : (v3 ? p3 : p4)));
    const v_index = v0 ? 0 : (v1 ? 1 : (v2 ? 2 : (v3 ? 3 : 4)));
    
    return DisputeResult {
        violator_found: found,
        violator_price: v_price,
        violator_index: v_index
    };
}
